{
  "name": "meters-ch",
  "version": "1.2.5",
  "description": "Meters.ch Website",
  "author": "Tim Winkelmann",
  "private": true,
  "scripts": {
    "dev": "cross-env NUXT_HOST=0.0.0.0 nuxi dev",
    "build": "nuxi build",
    "start": "cross-env NUXT_HOST=0.0.0.0 nuxi preview",
    "generate": "nuxi generate",
    "deploy": "push-dir --dir=dist --branch=gh-pages --cleanup",
    "reformat": "prettier \"**/*.{js,json,html,vue}\" --write",
    "patch": "node patch/patch-node-modules.js",
    "postinstall": "yarn patch"
  },
  "dependencies": {
    "@nuxtjs/pwa": "^3.3.5",
    "@pinia/nuxt": "^0.1.9",
    "chart.js": "^2.9.4",
    "chartjs-adapter-luxon": "^0.2.2",
    "leaflet": "^1.7.1",
    "luxon": "^1.25.0",
    "nuxt-edge": "latest",
    "pinia": "^2.0.14",
    "vue-i18n": "^8.22.2"
  },
  "devDependencies": {
    "@nuxt/bridge": "npm:@nuxt/bridge-edge",
    "@nuxtjs/style-resources": "^1.2.1",
    "@types/leaflet": "^1.7.11",
    "cross-env": "^7.0.3",
    "fibers": "^5.0.1",
    "lodash": "^4.17.21",
    "node-sass": "^7.0.1",
    "nuxt-purgecss": "^1.0.0",
    "prettier": "2.1.2",
    "push-dir": "^0.4.1",
    "sass-loader": "^10.1.1",
    "tailwindcss": "^1.0.0"
  }
}
